# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server configuration
PORT=3000
NODE_ENV=development

# Security secret for cryptographic signing of session tokens
SESSION_SECRET="secret-session-key-change-in-production-12345"

# Access code & Admin settings
# In development, ALLOW_DEMO_CODE enables the development demo code '07080717'
ALLOW_DEMO_CODE=true
ADMIN_KEY="admin_savollar_2026"
